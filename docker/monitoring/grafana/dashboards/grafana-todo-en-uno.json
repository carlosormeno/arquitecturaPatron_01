{
  "title": "SEACE – Observabilidad TODO-EN-UNO (por secciones)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "label": "Jobs (apps)",
        "query": "label_values(up{job=~\"command-service|query-service|comando-microservicio|consulta-microservicio\"}, job)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "bb_job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "label": "Blackbox Job",
        "query": "label_values(probe_success{job=~\"blackbox.*\"}, job)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "bb_instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "label": "Blackbox Target",
        "query": "label_values(probe_success{job=~\"$bb_job\"}, instance)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Infraestructura",
      "id": 100,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "CPU usada (%) por instance",
          "id": 101,
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 1
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
              "refId": "A",
              "legendFormat": "{{instance}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Memoria usada (%) por instance",
          "id": 102,
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 1
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
              "refId": "A",
              "legendFormat": "{{instance}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Disco usado (%) (excluye tmpfs/overlay)",
          "id": 103,
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 1
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|aufs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|aufs\"}))",
              "refId": "A",
              "legendFormat": "{{instance}} {{mountpoint}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Red – Receive/Transmit (bytes/s)",
          "id": 104,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 9
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo\"}[5m]))",
              "refId": "A",
              "legendFormat": "rx {{instance}}"
            },
            {
              "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo\"}[5m]))",
              "refId": "B",
              "legendFormat": "tx {{instance}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "Bps"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Node Exporter – up()",
          "id": 105,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 9
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "up{job=~\"node-exporter\"}",
              "refId": "A",
              "legendFormat": "{{instance}}"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "title": "Aplicaciones (Spring Boot)",
      "id": 200,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "P95 Latency (s)",
          "id": 201,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 18
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "app:http_latency_p95:rate5m{job=~\"$job\"}",
              "refId": "A",
              "legendFormat": "{{job}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Throughput (req/s)",
          "id": 202,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 18
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
              "refId": "A",
              "legendFormat": "{{job}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops"
            },
            "overrides": []
          }
        },
        {
          "type": "stat",
          "title": "Error rate 5xx (%)",
          "id": 203,
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 0,
            "y": 26
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "app:http_error_rate_5xx:rate5m{job=~\"$job\"} * 100",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green"
                  },
                  {
                    "value": 5,
                    "color": "yellow"
                  },
                  {
                    "value": 10,
                    "color": "red"
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "values": false
            }
          }
        },
        {
          "type": "timeseries",
          "title": "P95 por URI (top)",
          "id": 204,
          "gridPos": {
            "h": 6,
            "w": 18,
            "x": 6,
            "y": 26
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, topk(10, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=~\"$job\"}[5m]))))",
              "refId": "A",
              "legendFormat": "{{uri}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Kafka",
      "id": 300,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "Messages In /s",
          "id": 301,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 33
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "kafka:messages_in_per_sec:rate5m",
              "refId": "A",
              "legendFormat": "{{job}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops"
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "Consumer Lag (por group)",
          "id": 302,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 33
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "kafka:consumergroup_lag:sum",
              "refId": "A",
              "legendFormat": "{{consumergroup}}"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Under-replicated partitions",
          "id": 303,
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 0,
            "y": 41
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "sum(kafka_server_replicamanager_underreplicatedpartitions)",
              "refId": "A"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green"
                  },
                  {
                    "value": 1,
                    "color": "red"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "stat",
          "title": "Brokers",
          "id": 304,
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 6,
            "y": 41
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "kafka_brokers",
              "refId": "A"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Elasticsearch / OpenSearch",
      "id": 400,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "panels": [
        {
          "type": "stat",
          "title": "Cluster Health",
          "id": 401,
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 0,
            "y": 48
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "es:cluster_health_status",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "GREEN"
                    },
                    "1": {
                      "text": "YELLOW"
                    },
                    "2": {
                      "text": "RED"
                    }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green"
                  },
                  {
                    "value": 1,
                    "color": "yellow"
                  },
                  {
                    "value": 2,
                    "color": "red"
                  }
                ]
              }
            }
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          }
        },
        {
          "type": "stat",
          "title": "FS libre (mín %)",
          "id": 402,
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 6,
            "y": 48
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "es:fs_free_ratio:min * 100",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red"
                  },
                  {
                    "value": 15,
                    "color": "yellow"
                  },
                  {
                    "value": 25,
                    "color": "green"
                  }
                ]
              }
            }
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          }
        },
        {
          "type": "timeseries",
          "title": "Nodos en el cluster",
          "id": 403,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 48
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "elasticsearch_cluster_health_number_of_nodes",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Docs por índice (top 10)",
          "id": 404,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 54
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "topk(10, elasticsearch_indices_docs)",
              "refId": "A",
              "legendFormat": "{{index}}"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "title": "Blackbox",
      "id": 500,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "panels": [
        {
          "type": "table",
          "title": "Targets con fallas (últimos 5m)",
          "id": 501,
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 63
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "max_over_time((probe_success{job=~\"$bb_job\"}==0)[5m])",
              "refId": "A"
            }
          ],
          "options": {
            "showHeader": true
          }
        },
        {
          "type": "timeseries",
          "title": "Duración de probes (promedio 5m)",
          "id": 502,
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 70
          },
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "targets": [
            {
              "expr": "avg by (instance) (avg_over_time(probe_duration_seconds{job=~\"$bb_job\", instance=~\"$bb_instance\"}[5m]))",
              "refId": "A",
              "legendFormat": "{{instance}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          }
        }
      ]
    }
  ]
}