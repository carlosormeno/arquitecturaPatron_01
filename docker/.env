# ============================================
# COMANDOS ÚTILES PARA GENERAR SECRETS
# ============================================

# Generar password segura:
# openssl rand -base64 32

# Generar JWT secret:
# openssl rand -hex 64

# Generar Fernet key para Airflow:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"