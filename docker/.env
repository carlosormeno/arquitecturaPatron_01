# ===========================================
# ARCHIVO .env - VARIABLES DE ENTORNO COMPLETAS
# Stack Tecnológico Modular - Versión Final
# ===========================================
# IMPORTANTE: Añadir este archivo a .gitignore

# ============================================
# BASES DE DATOS PRINCIPALES
# ============================================

# PostgreSQL Principal
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Kong Database
KONG_DB_NAME=
KONG_DB_USER=
KONG_DB_PASSWORD=

# MongoDB
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ============================================
# SEGURIDAD Y AUTENTICACIÓN
# ============================================

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=

# CORS Configuration
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=

# ============================================
# KAFKA MESSAGING
# ============================================

KAFKA_BROKER_ID=
KAFKA_ZOOKEEPER_CONNECT=

# ============================================
# AMBIENTE Y PROFILES
# ============================================

ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# ============================================
# LOGGING CONFIGURATION
# ============================================

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_RETENTION_DAYS=14
LOGGING_STACK=both

# ============================================
# JVM OPTIMIZATION
# ============================================

JAVA_OPTS_COMMAND=
JAVA_OPTS_QUERY=

# ============================================
# RESOURCE LIMITS
# ============================================

# CPU limits (como decimal, ej: 0.5 = 50% de 1 CPU)
CPU_LIMIT_SMALL=0.25
CPU_LIMIT_MEDIUM=0.5
CPU_LIMIT_LARGE=1.0
CPU_LIMIT_XLARGE=2.0

# Memory limits
MEMORY_LIMIT_XSMALL=128m
MEMORY_LIMIT_SMALL=256m
MEMORY_LIMIT_MEDIUM=512m
MEMORY_LIMIT_LARGE=1g
MEMORY_LIMIT_XLARGE=2g

# ============================================
# HEALTHCHECK CONFIGURATION
# ============================================

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ============================================
# RETENTION POLICIES
# ============================================

PROMETHEUS_RETENTION=30d
ELASTICSEARCH_RETENTION=7d
LOKI_RETENTION=7d

# ============================================
# BACKUP SETTINGS
# ============================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Elasticsearch (ELK Stack)
ELASTIC_PASSWORD=
KIBANA_PASSWORD=

# Alerting
ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# ============================================
# IDENTITY LAYER - KEYCLOAK
# ============================================

KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ============================================
# SECURITY STACK
# ============================================

# SonarQube
SONARQUBE_DB_NAME=
SONARQUBE_DB_USER=
SONARQUBE_DB_PASSWORD=
SONARQUBE_ADMIN_USER=
SONARQUBE_ADMIN_PASSWORD=

# Snyk Free
SNYK_FREE_TOKEN=
SNYK_ORG_ID=

# OWASP ZAP
ZAP_API_KEY=

# Falco
FALCO_GRPC_ENABLED=
FALCO_GRPC_BIND_ADDRESS=

# ============================================
# CONTENT MANAGEMENT - ALFRESCO
# ============================================

ALFRESCO_DB_NAME=
ALFRESCO_DB_USER=
ALFRESCO_DB_PASSWORD=
ALFRESCO_ADMIN_USER=
ALFRESCO_ADMIN_PASSWORD=

# ============================================
# DATA PLATFORM - NIFI
# ============================================

NIFI_USERNAME=
NIFI_PASSWORD=
NIFI_SENSITIVE_PROPS_KEY=

# ============================================
# DATA GOVERNANCE - DATAHUB
# ============================================

DATAHUB_DB_NAME=
DATAHUB_DB_USER=
DATAHUB_DB_PASSWORD=
DATAHUB_SECRET=
DATAHUB_GMS_AUTH_TOKEN=

# ============================================
# WORKFLOW ORCHESTRATION - AIRFLOW
# ============================================

AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_EMAIL=
AIRFLOW_FERNET_KEY=

# ============================================
# BUSINESS RULES - GORULES
# ============================================

GORULES_LOG_LEVEL=info
GORULES_HOT_RELOAD=true
GORULES_CACHE_TTL=300
GORULES_WORKERS=4
GORULES_METRICS_ENABLED=true
GORULES_CACHE_ENABLED=true

# ============================================
# CI/CD STACK
# ============================================

# Gitea
GITEA_DB_NAME=
GITEA_DB_USER=
GITEA_DB_PASSWORD=
GITEA_SECRET_KEY=

# Harbor Registry
HARBOR_DB_NAME=
HARBOR_DB_USER=
HARBOR_DB_PASSWORD=
HARBOR_ADMIN_PASSWORD=
HARBOR_CORE_SECRET=
HARBOR_JOBSERVICE_SECRET=

# Nexus Repository
POSTGRES_NEXUS_PASSWORD=

# Compliance Dashboard
COMPLIANCE_DASHBOARD_PASSWORD=

# ============================================
# EDGE & GATEWAY
# ============================================

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=100m

# SSL Configuration
SSL_CERTIFICATE_PATH=
SSL_CERTIFICATE_KEY_PATH=

# ============================================
# DOMAIN CONFIGURATION
# ============================================

DOMAIN_NAME=
API_DOMAIN=
AUTH_DOMAIN=
CONTENT_DOMAIN=
DATA_DOMAIN=

# External URLs
EXTERNAL_URL=
KEYCLOAK_EXTERNAL_URL=
ALFRESCO_EXTERNAL_URL=
NIFI_EXTERNAL_URL=
DATAHUB_EXTERNAL_URL=
AIRFLOW_EXTERNAL_URL=

# ============================================
# INTEGRATION TOKENS (Para demos, usar tokens fake)
# ============================================

# GitHub Integration (opcional para CI/CD demos)
GITHUB_TOKEN=

# Snyk Broker (comercial - no usar en demo gratuita)
SNYK_BROKER_TOKEN=

# ShiftLeft (comercial - no incluir en demo)
SHIFTLEFT_ACCESS_TOKEN=

# ============================================
# PERFORMANCE TUNING
# ============================================

# Database Connection Pools
DB_CONNECTION_POOL_SIZE=
REDIS_CONNECTION_POOL_SIZE=
KAFKA_CONNECTION_POOL_SIZE=

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================
# MONITORING EXTRAS
# ============================================

CUSTOM_METRICS_ENABLED=true
BUSINESS_METRICS_ENABLED=true
APM_ENABLED=true
TRACING_SAMPLE_RATE=0.1

# SLA Monitoring
SLA_MONITORING_ENABLED=true
UPTIME_THRESHOLD=99.9
RESPONSE_TIME_THRESHOLD=2000

# ============================================
# SECURITY EXTRAS
# ============================================

SECURITY_SCAN_ENABLED=true
VULNERABILITY_SCAN_SCHEDULE=0 2 * * 0
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================
# DEVELOPMENT FLAGS
# ============================================

DEV_MODE=true
DEBUG_ENABLED=true
VERBOSE_LOGGING=false
TEST_DATA_ENABLED=false
MOCK_EXTERNAL_SERVICES=false

# Feature Flags
FEATURE_NEW_UI=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_ML_PIPELINE=false

# ============================================
# LOCALIZATION
# ============================================

TZ=America/Lima
DEFAULT_TIMEZONE=America/Lima
DEFAULT_LANGUAGE=es
DEFAULT_COUNTRY=PE
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss

# ============================================
# NETWORK CONFIGURATION
# ============================================

NETWORK_MODE=
DNS_SERVERS=

# Proxy Configuration (opcional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# ============================================
# EMAIL CONFIGURATION (Para notificaciones)
# ============================================

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================
# WEBHOOKS
# ============================================

WEBHOOK_ENABLED=
WEBHOOK_SECRET=

# ============================================
# COMPLIANCE & GOVERNANCE
# ============================================

GDPR_ENABLED=
DATA_RETENTION_POLICY_DAYS=
PERSONAL_DATA_ENCRYPTION=
SOX_AUDIT_ENABLED=
CHANGE_LOG_RETENTION_YEARS=
DATA_CLASSIFICATION_ENABLED=
SENSITIVE_DATA_MASKING=
