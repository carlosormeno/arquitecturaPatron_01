# ===========================================
# ARCHIVO .env - VARIABLES DE ENTORNO COMPLETAS
# Stack Tecnológico Modular - Versión Final
# ===========================================
# IMPORTANTE: Añadir este archivo a .gitignore

# ============================================
# BASES DE DATOS PRINCIPALES
# ============================================

# PostgreSQL Principal
POSTGRES_DB=productos_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kong Database
KONG_DB_NAME=kong
KONG_DB_USER=kong
KONG_DB_PASSWORD=kongpass

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=M0ng0_S3cur3_P4ssw0rd_2024!

# ============================================
# SEGURIDAD Y AUTENTICACIÓN
# ============================================

# JWT Configuration
JWT_SECRET=Sup3r_S3cur3_JWT_K3y_F0r_Pr0duct10n_2024_M1n1mum_32_Ch4r4ct3rs!
JWT_EXPIRATION=3600000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With

# ============================================
# KAFKA MESSAGING
# ============================================

KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# ============================================
# AMBIENTE Y PROFILES
# ============================================

ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# ============================================
# LOGGING CONFIGURATION
# ============================================

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_RETENTION_DAYS=14
LOGGING_STACK=both

# ============================================
# JVM OPTIMIZATION
# ============================================

JAVA_OPTS_COMMAND=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+PrintGCDetails -Dfile.encoding=UTF-8
JAVA_OPTS_QUERY=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+PrintGCDetails -Dfile.encoding=UTF-8

# ============================================
# RESOURCE LIMITS
# ============================================

# CPU limits (como decimal, ej: 0.5 = 50% de 1 CPU)
CPU_LIMIT_SMALL=0.25
CPU_LIMIT_MEDIUM=0.5
CPU_LIMIT_LARGE=1.0
CPU_LIMIT_XLARGE=2.0

# Memory limits
MEMORY_LIMIT_XSMALL=128m
MEMORY_LIMIT_SMALL=256m
MEMORY_LIMIT_MEDIUM=512m
MEMORY_LIMIT_LARGE=1g
MEMORY_LIMIT_XLARGE=2g

# ============================================
# HEALTHCHECK CONFIGURATION
# ============================================

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ============================================
# RETENTION POLICIES
# ============================================

PROMETHEUS_RETENTION=30d
ELASTICSEARCH_RETENTION=7d
LOKI_RETENTION=7d

# ============================================
# BACKUP SETTINGS
# ============================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Elasticsearch (ELK Stack)
ELASTIC_PASSWORD=El4st1c_S3cur3_P4ss_2024!
KIBANA_PASSWORD=K1b4n4_S3cur3_P4ss_2024!

# Alerting
ALERT_EMAIL=admin@tu-empresa.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ============================================
# IDENTITY LAYER - KEYCLOAK
# ============================================

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# ============================================
# SECURITY STACK
# ============================================

# SonarQube
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube123
SONARQUBE_ADMIN_USER=admin
SONARQUBE_ADMIN_PASSWORD=admin

# Snyk Free
SNYK_FREE_TOKEN=29f71c30-8284-4463-b2d6-52a163a12344
SNYK_ORG_ID=your-org-id-here

# OWASP ZAP
ZAP_API_KEY=zap-api-key-12345

# Falco
FALCO_GRPC_ENABLED=true
FALCO_GRPC_BIND_ADDRESS=0.0.0.0:5060

# ============================================
# CONTENT MANAGEMENT - ALFRESCO
# ============================================

ALFRESCO_DB_NAME=alfresco
ALFRESCO_DB_USER=alfresco
ALFRESCO_DB_PASSWORD=alfresco123
ALFRESCO_ADMIN_USER=admin
ALFRESCO_ADMIN_PASSWORD=admin

# ============================================
# DATA PLATFORM - NIFI
# ============================================

NIFI_USERNAME=admin
NIFI_PASSWORD=admin123456789
NIFI_SENSITIVE_PROPS_KEY=nifi123456789012

# ============================================
# DATA GOVERNANCE - DATAHUB
# ============================================

DATAHUB_DB_NAME=datahub
DATAHUB_DB_USER=datahub
DATAHUB_DB_PASSWORD=datahub123
DATAHUB_SECRET=datahub123456789012345678901234567890
DATAHUB_GMS_AUTH_TOKEN=datahub-gms-token-2024

# ============================================
# WORKFLOW ORCHESTRATION - AIRFLOW
# ============================================

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin123
AIRFLOW_EMAIL=admin@empresa.com
AIRFLOW_FERNET_KEY=airflow123456789012345678901234567890123456789012345

# ============================================
# BUSINESS RULES - GORULES
# ============================================

GORULES_LOG_LEVEL=info
GORULES_HOT_RELOAD=true
GORULES_CACHE_TTL=300
GORULES_WORKERS=4
GORULES_METRICS_ENABLED=true
GORULES_CACHE_ENABLED=true

# ============================================
# CI/CD STACK
# ============================================

# Gitea
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=gitea123
GITEA_SECRET_KEY=gitea-secret-key-12345678901234567890123456789012345678901234567890

# Harbor Registry
HARBOR_DB_NAME=harbor
HARBOR_DB_USER=harbor
HARBOR_DB_PASSWORD=harbor123
HARBOR_ADMIN_PASSWORD=Harbor12345
HARBOR_CORE_SECRET=harbor-core-secret-12345678901234567890
HARBOR_JOBSERVICE_SECRET=harbor-jobservice-secret-12345678901234567890

# Nexus Repository
POSTGRES_NEXUS_PASSWORD=nexus123

# Compliance Dashboard
COMPLIANCE_DASHBOARD_PASSWORD=compliance123

# ============================================
# EDGE & GATEWAY
# ============================================

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=100m

# SSL Configuration
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================
# DOMAIN CONFIGURATION
# ============================================

DOMAIN_NAME=localhost
API_DOMAIN=api.localhost
AUTH_DOMAIN=auth.localhost
CONTENT_DOMAIN=content.localhost
DATA_DOMAIN=data.localhost

# External URLs
EXTERNAL_URL=http://localhost
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
ALFRESCO_EXTERNAL_URL=http://localhost:8082
NIFI_EXTERNAL_URL=http://localhost:8084
DATAHUB_EXTERNAL_URL=http://localhost:9003
AIRFLOW_EXTERNAL_URL=http://localhost:8086

# ============================================
# INTEGRATION TOKENS (Para demos, usar tokens fake)
# ============================================

# GitHub Integration (opcional para CI/CD demos)
GITHUB_TOKEN=demo-github-token-not-real

# Snyk Broker (comercial - no usar en demo gratuita)
SNYK_BROKER_TOKEN=demo-snyk-broker-token-not-real

# ShiftLeft (comercial - no incluir en demo)
SHIFTLEFT_ACCESS_TOKEN=demo-shiftleft-token-not-real

# ============================================
# PERFORMANCE TUNING
# ============================================

# Database Connection Pools
DB_CONNECTION_POOL_SIZE=10
REDIS_CONNECTION_POOL_SIZE=20
KAFKA_CONNECTION_POOL_SIZE=5

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================
# MONITORING EXTRAS
# ============================================

CUSTOM_METRICS_ENABLED=true
BUSINESS_METRICS_ENABLED=true
APM_ENABLED=true
TRACING_SAMPLE_RATE=0.1

# SLA Monitoring
SLA_MONITORING_ENABLED=true
UPTIME_THRESHOLD=99.9
RESPONSE_TIME_THRESHOLD=2000

# ============================================
# SECURITY EXTRAS
# ============================================

SECURITY_SCAN_ENABLED=true
VULNERABILITY_SCAN_SCHEDULE=0 2 * * 0
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================
# DEVELOPMENT FLAGS
# ============================================

DEV_MODE=true
DEBUG_ENABLED=true
VERBOSE_LOGGING=false
TEST_DATA_ENABLED=false
MOCK_EXTERNAL_SERVICES=false

# Feature Flags
FEATURE_NEW_UI=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_ML_PIPELINE=false

# ============================================
# LOCALIZATION
# ============================================

TZ=America/Lima
DEFAULT_TIMEZONE=America/Lima
DEFAULT_LANGUAGE=es
DEFAULT_COUNTRY=PE
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss

# ============================================
# NETWORK CONFIGURATION
# ============================================

NETWORK_MODE=bridge
DNS_SERVERS=8.8.8.8,8.8.4.4

# Proxy Configuration (opcional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,*.local

# ============================================
# EMAIL CONFIGURATION (Para notificaciones)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@tu-empresa.com

# ============================================
# WEBHOOKS
# ============================================

WEBHOOK_ENABLED=true
WEBHOOK_SECRET=webhook-secret-key-2024

# ============================================
# COMPLIANCE & GOVERNANCE
# ============================================

GDPR_ENABLED=true
DATA_RETENTION_POLICY_DAYS=2555
PERSONAL_DATA_ENCRYPTION=true
SOX_AUDIT_ENABLED=true
CHANGE_LOG_RETENTION_YEARS=7
DATA_CLASSIFICATION_ENABLED=true
SENSITIVE_DATA_MASKING=true

# ============================================
# NOTAS IMPORTANTES PARA PRODUCCIÓN
# ============================================

